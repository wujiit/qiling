        "kc_items": [
          {
            "term": "高内聚低耦合",
            "definition": "将强关联逻辑闭环于单一上下文，边界之外仅通过显式契约交互，降低跨域修改的涟漪效应。",
            "importance": "high"
          },
          {
            "term": "故障域隔离 (Blast Radius)",
            "definition": "任意子系统或组件的崩溃绝不应在网络中引发雪崩，以舱壁模式与熔断机制坚守系统韧性。",
            "importance": "critical"
          },
          {
            "term": "状态机显式化",
            "definition": "彻底抛弃离散脆弱的状态标志位，将业务生命周期建模为确定性有限状态机，根除并发状态幽灵。",
            "importance": "high"
          }
        ]
      }
