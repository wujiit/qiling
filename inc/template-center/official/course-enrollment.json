      "type": "curriculum",
      "data": {
        "curriculum_title": "体系化实战教学大纲与进阶路径",
        "curriculum_subtitle": "为期 16 周的硬核沉浸式训练，理论推导与产业级代码实战 1:2 深度配比",
        "curriculum_items": [
          {
            "title": "第一阶段：算法底层原理与数学基石 (Foundations & Math)",
            "meta": "第 1-4 周 · 理论攻坚 · 40 课时",
            "content": "深入剖析线性代数、概率图模型与凸优化理论。手写反向传播求导引擎，彻底掌握现代神经网络梯度传递与张量计算底层机制。",
            "open": "yes"
          },
          {
            "title": "第二阶段：大模型微调与 RAG 工业级知识库构建 (LLM Fine-tuning & RAG)",
            "meta": "第 5-8 周 · 核心实战 · 50 课时",
            "content": "LoRA / QLoRA 轻量化微调技术、混合精度训练分布式 DeepSpeed 优化，结合向量数据库与重排算法 (Re-ranking) 打造企业级防幻觉知识库。",
            "open": "no"
          },
          {
            "title": "第三阶段：多智能体编排与自主任务决策 (Autonomous Multi-Agents)",
            "meta": "第 9-12 周 · 进阶工程 · 50 课时",
            "content": "基于 LangGraph / AutoGen 实现多 Agent 角色协作、工具自调用与反思纠错循环，实现复杂长流程业务自动拆解与无缝执行。",
            "open": "no"
          },
          {
            "title": "第四阶段：产业级 Capstone 毕设项目路演与大厂内推 (Capstone Defense)",
            "meta": "第 13-16 周 · 成果交付 · 30 课时",
            "content": "在导师指导下独立完成可上线部署的真实商业级闭环项目，撰写架构白皮书，直接面向一线投资人与大厂技术 VP 进行结业答辩。",
            "open": "no"
          }
        ]
      }
