msgstr "Konfigurieren Sie Frontend-Sprachen, siehe Translate.js-Dokumente"

msgid "语言配置"
msgstr "Sprachkonfiguration"

msgid "语言名称"
msgstr "Sprachname"

msgid "语言简码"
msgstr "Sprach-Shortcode"

msgid "图标（可选）"
msgstr "Symbol (optional)"

