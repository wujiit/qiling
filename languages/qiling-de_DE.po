msgstr "Eine Domain pro Zeile. Preconnect ist schneller, verbraucht aber mehr Ressourcen"

msgid "心跳控制"
msgstr "Herzschlagkontrolle"

msgid "优化 WordPress Admin 后台心跳频率，减少服务器负载"
msgstr "Optimieren Sie die WP Admin Heartbeat-Frequenz"

msgid "心跳优化"
msgstr "Heartbeat-Optimierung"

msgid "不修改（默认 15 秒）"
msgstr "Keine Änderung (Standard 15 s)"

msgid "减慢至 30 秒"
msgstr "Langsam bis 30s"

msgid "减慢至 60 秒"
msgstr "Langsam bis 60s"

msgid "减慢至 120 秒"
msgstr "Langsam auf 120s"

msgid "仅禁用前台"
msgstr "Nur Frontend"

