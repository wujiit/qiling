msgid "JS 加载策略"
msgstr "JS-Ladestrategie"

msgid "跟随主题默认（安全 defer）"
msgstr "Theme-Standard folgen (sichere Verzögerung)"

msgid "不优化"
msgstr "Nicht optimiert"

