msgstr ""
"Après l'avoir activé, lorsqu'un visiteur ouvre le site Web dans le navigateur intégré de WeChat, "
"seule la page d'invite s'affichera et le contenu du site Web ne sera pas chargé."

msgid "微信拦截标题"
msgstr "Titre du bloc WeChat"

msgid "不支持在微信内访问"
msgstr "L'accès au sein de WeChat n'est pas pris en charge"

msgid "微信拦截提示"
msgstr "Astuce WeChatblock"

msgid "请点击右上角菜单，选择“在浏览器中打开”后继续访问。"
msgstr "Veuillez cliquer sur le menu dans le coin supérieur droit et sélectionner « Ouvrir dans le navigateur » pour continuer la visite."

msgid "评论优化"
msgstr "Optimisation des commentaires"

msgid "减少垃圾评论，优化评论功能"
msgstr "Réduisez le spam, optimisez les commentaires"

msgid "完全禁用评论"
msgstr "Désactiver complètement les commentaires"

msgid "禁用整个网站的评论功能（适合企业官网）"
msgstr "Désactiver tous les commentaires"

msgid "评论蜜罐陷阱"
msgstr "Commentaire"

msgid "添加隐藏字段检测机器人垃圾评论（无需验证码）"
msgstr "Pot de miel (sans Captcha)"

msgid "链接优化（SEO）"
msgstr "Optimisation des liens (SEO)"

msgid "优化网站链接结构，提升搜索引擎友好度"
msgstr "Optimiser les permaliens pour le référencement"

msgid "分类去 category"
msgstr "Supprimer le préfixe de catégorie"

msgid "分类链接去除 /category/ 前缀，如 /category/news/ 变为 /news/"
msgstr "Supprimer le préfixe /category/ des URL de catégorie"

msgid "后台编辑器优化（Gutenberg）"
msgstr "Optimisation de l'éditeur d'arrière-plan (Gutenberg)"

msgid "在不禁用区块编辑器的前提下，减少后台编辑页不必要请求与功能负担"
msgstr "Réduisez les requêtes inutiles et la charge fonctionnelle sur la page d’édition en arrière-plan sans désactiver l’éditeur de blocs."

msgid "关闭远程区块 Patterns"
msgstr "Fermer les modèles de blocs distants"

msgid "禁用 WordPress.org 远程 Patterns 拉取，减少编辑器初始化请求"
msgstr "Désactivez l'extraction de modèles à distance WordPress.org pour réduire les demandes d'initialisation de l'éditeur."

msgid "关闭区块目录搜索"
msgstr "Désactiver la recherche dans le répertoire de blocage"

msgid "禁用“添加区块”时的在线区块目录检索，提升编辑器响应"
msgstr "Désactivez la récupération du répertoire de blocs en ligne lors de l'ajout d'un bloc pour améliorer la réactivité de l'éditeur."

msgid "关闭 Openverse 媒体面板"
msgstr "Fermez le panneau multimédia Openverse"

msgid "隐藏编辑器中的 Openverse 在线媒体入口，减少后台远程依赖"
msgstr "Masquez le portail multimédia en ligne Openverse dans l'éditeur pour réduire la dépendance à distance en arrière-plan"

msgid "精简编辑器预加载接口"
msgstr "Interface de préchargement de l'éditeur simplifiée"

msgid "移除区块目录/Pattern 目录等重型预加载接口，降低初始化请求压力（默认不截断必要端点）"
msgstr "移除区块目录/Pattern 目录等重型预加载接口，降低初始化请求压力（默认不截断必要端点）"
"Supprimez les interfaces de préchargement lourdes telles que le répertoire de blocs/le répertoire "
"demodèles pour réduire la pression des demandes d'initialisation (les points de terminaison "
"nécessaires ne sont pas tronqués par défaut)"

msgid "自动更新控制"
msgstr "contrôle automatique des mises à jour"

msgid "按需控制 WordPress 自动更新行为，默认保持官方策略"
msgstr "Contrôlez le comportement de mise à jour automatique de WordPress à la demande et maintenez la politique officielle par défaut"

msgid "禁用核心自动更新"
msgstr "Désactiver les mises à jour automatiques principales"

msgid "禁用 WordPress 核心版本的自动更新（包含安全小版本）"
msgstr "Désactivez les mises à jour automatiques des versions principales de WordPress (y compris les versions mineures de sécurité)"

msgid "禁用插件自动更新"
msgstr "Plugin inactif automatiquement mis à jour"

msgid "禁用所有插件的自动更新"
msgstr "Désactivez les mises à jour automatiques pour tous les plugins"

msgid "禁用主题自动更新"
msgstr "Thème inactif automatiquement mis à jour"

msgid "禁用所有主题的自动更新"
msgstr "Désactivez les mises à jour automatiques pour tous les thèmes"

msgid "禁用翻译包自动更新"
msgstr "Désactiver les mises à jour automatiques des packages de traduction"

msgid "禁用语言包和翻译文件的自动更新"
msgstr "Désactiver les mises à jour automatiques des modules linguistiques et des fichiers de traduction"

msgid "禁用自动更新通知邮件"
msgstr "Désactiver les e-mails de notification de mise à jour automatique"

msgid "关闭核心/插件/主题自动更新结果邮件通知"
msgstr "Désactiver la notification par e-mail des résultats de la mise à jour automatique du noyau/plug-in/thème"

msgid "⚠️ 建议至少保留核心安全更新。若全部禁用，请建立手动更新流程（如每周检查一次）。"
msgstr ""
"⚠️ Il est recommandé de conserver au moins les mises à jour de sécurité principales. Si tous sont "
"désactivés, veuillez établir un processus de mise à jour manuelle (comme une vérification une fois "
"par semaine)."

msgid "性能优化"
msgstr "Optimisation des performances"

msgid "前端资源加载优化"
msgstr "Optimisation du chargement des actifs frontend"

msgid "启用 CSS 压缩"
msgstr "Activer la minification CSS"

msgid "前台优先加载 .min.css 版本（如果存在）"
msgstr "Chargez d'abord .min.css s'il existe"

msgid "移除资源版本号"
msgstr "Supprimer la version de l'actif"

msgid "移除 CSS/JS 资源链接中的 ?ver= 参数"
msgstr "Supprimer ?ver= de CSS/JS"

msgid "可提升浏览器缓存命中率，但更新后可能需要手动清除浏览器缓存"
msgstr "Améliore le taux de réussite du cache, peut nécessiter un effacement manuel après la mise à jour"

msgid "HTML 代码压缩"
msgstr "Minification HTML"

msgid "压缩 HTML 输出，移除多余空白和换行"
msgstr "Réduisez la sortie HTML, supprimez les espaces"

msgid "⚠️ 实验性功能：可能影响内联 JS/CSS，如遇问题请关闭此选项"
msgstr "⚠️ Expérimental : peut affecter le JS/CSS en ligne. Désactiver si des problèmes surviennent"

msgid "功能模块 CSS 加载方式"
msgstr "Méthode de chargement CSS du module de fonction"

msgid "单文件模式（modules.css 整包，默认）"
msgstr "Mode fichier unique (package complet modules.css, par défaut)"

msgid "按需模式（_shared + 当前页面模块）"
msgstr "Mode à la demande (module _shared + page actuelle)"

msgid "按需模式会读取 modules-hero.css（页面含首屏模块时）与 assets/css/modules-split/（_shared.css + 当前页面模块文件）；不会再加载 modules.css 整包。"
msgstr "按需模式会读取 modules-hero.css（页面含首屏模块时）与 assets/css/modules-split/（_shared.css + 当前页面模块文件）；不会再加载 modules.css 整包。"
"Le mode à la demande lira modules-hero.css (lorsque la page contient des modules de premier écran) "
"et assets/css/modules-split/ (_shared.css + fichier de module de la page actuelle) ; l'intégralité "
"du package modules.css ne sera pas chargé."

msgid "开启前请先点击下方按钮生成压缩文件，如果已经有了就不用再次生成。生成的压缩文件位于 assets/css/ 目录下。"
msgstr "Générez d'abord un fichier minifié. Situé dans actifs/css/."

msgid "图片延迟加载"
msgstr "Chargement paresseux de l'image"

msgid "启用图片懒加载，图片进入视口时才加载（使用原生 loading=\"lazy\"）"
msgstr "Activer le chargement paresseux natif"

msgid "视频/iframe 延迟加载"
msgstr "Chargement paresseux vidéo/iframe"

msgid "启用 iframe 和嵌入视频的懒加载"
msgstr "Activer le chargement différé pour iframe/vidéo"

msgid "禁用 jQuery Migrate"
msgstr "Désactiver la migration jQuery"

msgid "移除 jQuery Migrate 脚本（如果不使用老旧插件，建议禁用以提升性能）"
msgstr "Supprimer le script jQuery Migrate (désactiver si vous n'utilisez pas d'anciens plugins)"

msgid "启用查询参数优化"
msgstr "Activer l'optimisation des paramètres de requête"

msgid "自动为非分页查询启用 no_found_rows 等低风险优化，减少 SQL 开销"
msgstr "Activez automatiquement les optimisations à faible risque telles que no_found_rows pour les requêtes non paginées afin de réduire la surcharge SQL"

msgid "启用查询结果缓存"
msgstr "Activer la mise en cache des résultats de requête"

msgid "缓存高频 WP_Query 结果，减少重复查询（推荐开启）"
msgstr "Mettre en cache les résultats WP_Query à haute fréquence pour réduire les requêtes répétées (il est recommandé de l'activer)"

msgid "查询缓存时长"
msgstr "Durée du cache des requêtes"

msgid "建议 120-600 秒；内容更新后会自动失效"
msgstr "Recommandé 120 à 600 secondes ; il expirera automatiquement après la mise à jour du contenu"

msgid "启用页面片段缓存"
msgstr "Activer la mise en cache des fragments de page"

msgid "缓存相关文章等可复用 HTML 片段，降低渲染与查询成本"
msgstr "Mettez en cache les articles pertinents et autres fragments HTML réutilisables pour réduire les coûts de rendu et de requête"

msgid "片段缓存时长"
msgstr "Durée du cache des fragments"

msgid "启用性能监测浮层"
msgstr "Activer la superposition de surveillance des performances"

msgid "仅管理员前台可见，显示当前页面加载时间、SQL 次数、内存等指标"
msgstr "仅管理员前台可见，显示当前页面加载时间、SQL 次数、内存等指标"
"Visible uniquement par la réception de l'administrateur, il affiche le temps de chargement actuel "
"dela page, les temps SQL, la mémoire et d'autres indicateurs."

msgid "JS 加载策略"
msgstr "Stratégie de chargement JS"

msgid "跟随主题默认（安全 defer）"
msgstr "Suivre le thème par défaut (différer en toute sécurité)"

msgid "不优化"
msgstr "Non optimisé"

msgid "仅延迟非关键脚本（推荐）"
msgstr "Retarder uniquement les scripts non critiques (recommandé)"

msgid "激进：尽可能 defer（需自行验证）"
msgstr "Radical : différer le plus possible (à vérifier par vous-même)"

msgid "用于减少阻塞渲染脚本。激进模式可能影响部分依赖顺序严格的插件。"
msgstr "Utilisé pour réduire le blocage des scripts de rendu. Le mode agressif peut affecter certains plugins qui dépendent de composants strictement ordonnés."

msgid "JS 排除句柄"
msgstr "Poignée d'exclusion JS"

msgid "每行一个脚本 handle（也支持逗号分隔），例如：my-slider-script"
msgstr "Un handle de script par ligne (la séparation par des virgules est également prise en charge), par exemple : my-slider-script"

msgid "启用 LCP 图片预加载"
msgstr "Activer le préchargement des images LCP"

msgid "优先预加载首屏关键图片，改善 LCP 指标"
msgstr "Prioriser le préchargement des images clés sur le premier écran pour améliorer les indicateurs LCP"

msgid "LCP 预加载来源"
msgstr "Source de préchargement LCP"

msgid "优先文章特色图（自动）"
msgstr "Prioriser les images présentées dans les articles (automatique)"

msgid "使用自定义图片 URL"
msgstr "Utiliser une URL d'image personnalisée"

msgid "LCP 自定义图片 URL"
msgstr "URL de l'image personnalisée LCP"

msgid "当上方选择“自定义图片 URL”时生效"
msgstr "En vigueur lorsque « URL d'image personnalisée » est sélectionné ci-dessus"

msgid "页面资源与质量审计"
msgstr "Ressources de la page et audit qualité"

msgid "为管理员生成当前页面资源清单，并检查 LCP、图片、移动端溢出、颜色对比度、标题层级、表单可访问性和 CLS 风险。"
msgstr "为管理员生成当前页面资源清单，并检查 LCP、图片、移动端溢出、颜色对比度、标题层级、表单可访问性和 CLS 风险。"
"Générez un inventaire des ressources de la page actuelle pour les administrateurs et vérifiez le "
"LCP, les images, le débordement mobile, le contraste des couleurs, la hiérarchie des en-têtes, "
"l'accessibilité des formulaires et les risques CLS."

msgid "启用页面质量审计"
msgstr "Activer l'audit de la qualité des pages"

msgid "仅管理员前台访问时运行，不影响普通访客；也可在前台 URL 添加 ?qiling_page_audit=1 临时查看。"
msgstr "仅管理员前台访问时运行，不影响普通访客；也可在前台 URL 添加 ?qiling_page_audit=1 临时查看。"
"Il ne fonctionne que lorsque l'administrateur accède à la réception et n'affecte pas les visiteurs "
"ordinaires ; vous pouvez également ajouter ?qiling_page_audit=1 à l'URL de la réception pour une "
"visualisation temporaire."

msgid "在页面底部输出 JSON 清单"
msgstr "Liste JSON de sortie en bas de la page"

msgid "开启后管理员前台可在源码中看到 qiling-page-resource-manifest 和 qiling-page-quality-audit；调试完成后建议关闭。"
msgstr "开启后管理员前台可在源码中看到 qiling-page-resource-manifest 和 qiling-page-quality-audit；调试完成后建议关闭。"
"Après ouverture, l'administrateur peut voir qiling-page-resource-manifest et "
"qiling-page-quality-audit dans le code source à la réception ; il est recommandé de les fermer une "
"fois le débogage terminé."

msgid "媒体优化"
msgstr "Optimisation des médias"

msgid "文件上传与头像设置"
msgstr "Paramètres de téléchargement de fichiers et d'avatar"

msgid "禁用 Gravatar 头像"
msgstr "Désactiver Gravatar"

msgid "彻底禁用 Gravatar 远程请求，使用本地默认头像代替（解决 Gravatar 被墙或加载慢的问题）"
msgstr "Désactivez complètement les requêtes Gravatar, utilisez l'avatar local par défaut."

msgid "上传文件名重命名"
msgstr "Renommer les fichiers téléchargés"

msgid "上传时自动将中文等特殊文件名重命名为随机字母数字组合（防止乱码和路径问题）"
msgstr "Renommer automatiquement les téléchargements en caractères alphanumériques aléatoires"

msgid "允许上传 SVG 图片"
msgstr "Autoriser le téléchargement d'images SVG"

msgid "开启后管理员可在媒体库上传 .svg 文件，主题会在上传前清洗 SVG 代码；不支持 .svgz。"
msgstr "开启后管理员可在媒体库上传 .svg 文件，主题会在上传前清洗 SVG 代码；不支持 .svgz。"
"Après l'avoir activé, les administrateurs peuvent télécharger des fichiers .svg dans la "
"médiathèque,et le thème nettoiera le code SVG avant le téléchargement ; .svgz n'est pas pris en "
"charge."

msgid "WebP 图片转换"
msgstr "Conversion WebP"

msgid "将图片自动转换为 WebP 格式以减少文件大小"
msgstr "Convertir automatiquement les images en WebP pour réduire la taille"

msgid "启用 WebP 转换"
msgstr "Activer la conversion WebP"

msgid "上传图片时自动转换并替换为 WebP（仅 JPG/JPEG/PNG，GIF 保持原格式）"
msgstr "Convertissez et remplacez automatiquement les images en WebP lors du téléchargement (uniquement JPG/JPEG/PNG, GIF conserve le format d'origine)"

msgid "✓ 服务器支持 WebP（GD 库已启用）"
msgstr "✓ Le serveur prend en charge WebP (bibliothèque GD activée)"

msgid "⚠ 服务器不支持 WebP，请安装 GD 库的 WebP 模块"
msgstr "⚠ Le serveur ne prend pas en charge WebP. Installez le module GD WebP."

msgid "WebP 质量"
msgstr "Qualité WebP"

msgid "WebP 图片压缩质量（1-100），建议 75-85"
msgstr "Qualité WebP (Rec : 75-85)"

msgid "图片尺寸优化"
msgstr "Optimisation de la taille de l'image"

msgid "控制 WordPress 自动生成的图片缩略图，节省服务器空间"
msgstr "Contrôlez les miniatures automatiques de WP pour économiser de l'espace"

msgid "禁用大图压缩"
msgstr "Désactiver la compression des grandes images"

msgid "禁用 WordPress 自动缩放大于 2560px 的图片"
msgstr "Désactivez la mise à l'échelle automatique WP pour les images> 2560px"

msgid "禁用多尺寸缩略图"
msgstr "Désactiver les vignettes multi-tailles"

msgid "禁止 WordPress 上传时自动生成多个尺寸的缩略图，节省服务器空间"
msgstr "Empêcher WP de générer plusieurs tailles de vignettes"

msgid "⚠️ 启用后新上传的图片只保留原图，可能影响依赖特定尺寸的功能"
msgstr "⚠️ Conserve l'original uniquement. Peut casser les fonctionnalités des vignettes !"

msgid "资源预加载"
msgstr "Préchargement des ressources"

msgid "提前解析和连接外部资源，加速页面加载"
msgstr "Précharger/préconnecter les ressources externes"

msgid "主 CDN 地址"
msgstr "Adresse CDN principale"

msgid "用于输出 preconnect 标签（如 https://cdn.example.com）。如已在下方“预连接域名”中配置可留空"
msgstr "用于输出 preconnect 标签（如 https://cdn.example.com）。如已在下方“预连接域名”中配置可留空"
"Utilisé pour générer des balises de préconnexion (telles que https://cdn.example.com).). S'il a été "
"configuré dans le \"Nom de domaine de pré-connexion\" ci-dessous, il peut être laissé vide."

msgid "DNS 预解析域名"
msgstr "Domaines de prélecture DNS"

msgid "每行一个域名（不含 http://），如：fonts.googleapis.com、cdn.jsdelivr.net"
msgstr "Un domaine par ligne (pas de http://),, par exemple fonts.googleapis.com"

msgid "预连接域名"
msgstr "Domaines de préconnexion"

msgid "每行一个域名（不含 http://），如：fonts.gstatic.com。预连接比预解析更快但消耗更多资源"
msgstr "Un domaine par ligne. La préconnexion est plus rapide mais utilise plus de ressources"

msgid "心跳控制"
msgstr "Contrôle du rythme cardiaque"

msgid "优化 WordPress Admin 后台心跳频率，减少服务器负载"
msgstr "Optimiser la fréquence de battement de coeur de l'administrateur WP"

msgid "心跳优化"
msgstr "Optimisation du rythme cardiaque"

msgid "不修改（默认 15 秒）"
msgstr "Aucun changement (15 s par défaut)"

msgid "减慢至 30 秒"
msgstr "Ralentir jusqu'à 30 s"

msgid "减慢至 60 秒"
msgstr "Lent jusqu'aux années 60"

msgid "减慢至 120 秒"
msgstr "Ralentir jusqu'à 120 s"

msgid "仅禁用前台"
msgstr "Front-end uniquement"

msgid "完全禁用（不推荐）"
msgstr "Désactiver complètement (non recommandé)"

msgid "心跳 API 用于自动保存和在线状态检测，频繁请求会增加服务器负担"
msgstr "L'API Heartbeat est utilisée pour la sauvegarde/le statut automatique. La haute fréquence augmente la charge"

msgid "编辑页心跳间隔"
msgstr "Modifier l'intervalle de pulsation de la page"

msgid "跟随上方“心跳优化”设置"
msgstr "Suivez les paramètres « Optimisation du rythme cardiaque » ci-dessus"

msgid "15 秒（WordPress 默认）"
msgstr "15 secondes (WordPress par défaut)"

msgid "30 秒（推荐）"
msgstr "30 secondes (recommandé)"

msgid "60 秒（更省资源）"
msgstr "60 secondes (contenu)"

msgid "120 秒（最低频）"
msgstr "120 secondes (contenu)"

msgid "仅作用于文章/页面编辑器（Gutenberg/经典编辑器）"
msgstr "Fonctionne uniquement dans l'éditeur d'articles/pages (Gutenberg/éditeur classique)"

msgid "后台其他页面心跳间隔"
msgstr "Intervalle de battement de coeur des autres pages d'arrière-plan"

msgid "30 秒"
msgstr "30 secondes"

msgid "60 秒（推荐）"
msgstr "60 secondes (recommandé)"

msgid "120 秒（更省资源）"
