msgid "导出一个包含主题主设置和招聘设置的 JSON 文件，兼容后续恢复导入。"
msgstr "导出一个包含主题主设置和招聘设置的 JSON 文件，兼容后续恢复导入。"
"Exportez un fichier JSON contenant les principaux paramètres du thème et les paramètres de "
"recrutement, compatible avec les importations de récupération ultérieures."

msgid "导入设置"
msgstr "Paramètres d'importation"

msgid "确定要导入设置吗？备份内容将合并恢复到当前设置中。"
msgstr "Êtes-vous sûr de vouloir importer les paramètres ? Le contenu de la sauvegarde sera fusionné et restauré aux paramètres actuels."

msgid "导入恢复设置"
msgstr "Importer et restaurer"

msgid "注意：导入操作会将备份内容合并恢复到当前主题设置中。建议先导出当前备份。"
msgstr "注意：导入操作会将备份内容合并恢复到当前主题设置中。建议先导出当前备份。"
"Remarque : L'opération d'importation fusionnera et restaurera le contenu de la sauvegarde avec les "
"paramètres de thème actuels. Il est recommandé d'exporter d'abord la sauvegarde actuelle."

msgid "未检测到上传文件"
msgstr "Fichier de téléchargement non détecté"

msgid "上传文件来源不合法，请重试。"
msgstr "La source du fichier téléchargé est illégale, veuillez réessayer."

msgid "仅支持导入 .json 设置文件。"
msgstr "Seule l'importation de fichiers de paramètres .json est prise en charge."

msgid "导入文件为空，请重新选择。"
msgstr "Le fichier d'importation est vide, veuillez resélectionner."

msgid "导入文件超过大小上限（最大 %s）。"
msgstr "Le fichier d'importation dépasse la limite de taille maximale (maximum %s)."

msgid "文件类型校验失败，请上传有效的 JSON 文件。"
msgstr "échec de la validation du type de fichier, veuillez télécharger un fichier JSON valide."

msgid "导入文件 MIME 类型不合法，请使用标准 JSON 文件。"
msgstr "Le type MIME du fichier importé n'est pas valide, veuillez utiliser un fichier JSON standard."

msgid "导入文件不可读，请重试。"
msgstr "Le fichier d'importation est illisible, veuillez réessayer."

msgid "导入文件内容为空。"
msgstr "Le contenu du fichier d'importation est vide."

