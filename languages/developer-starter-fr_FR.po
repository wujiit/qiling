msgstr "Configuration de la langue"

msgid "语言名称"
msgstr "Nom de la langue"

msgid "语言简码"
msgstr "Code court de langue"

msgid "图标（可选）"
msgstr "Icône (facultatif)"

msgid "繁体中文"
msgstr "Chinois traditionnel"

msgid "常用语言简码：chinese_simplified（简体中文）、chinese_traditional（繁体中文）、english（英语）、korean（韩语）、japanese（日语）"
msgstr "Courant : chinois_simplifié, chinois_traditionnel, anglais, coréen, japonais"

msgid "适合配合真实多语言文章/页面使用。默认语言走根路径，其他语言走 /语言简码/ 路径。"
msgstr "适合配合真实多语言文章/页面使用。默认语言走根路径，其他语言走 /语言简码/ 路径。"
"Convient pour une utilisation avec de vrais articles/pages multilingues. La langue par défaut suit "
"le chemin racine et les autres langues suivent le chemin /langue shortcode/."

