msgid "当前支持"
msgstr "目前支援"

msgid "页面包支持启灵模块装修页；整站包可额外携带全局设计、内容模型、菜单、首页/文章页映射和站点标题。"
msgstr "頁面包支援啟靈模組裝修頁；整站包可額外攜帶全域設計、內容模型、選單、首頁/文章頁映射和網站標題。"

msgid "当前不支持"
msgstr "目前不支援"

msgid "登录、注册、找回密码、个人中心等系统保留页会被拦截；第三方插件页面是否可迁移取决于插件自身能力。"
msgstr "登入、註冊、找回密碼、個人中心等系統保留頁會被攔截；第三方外掛頁面是否可遷移取決於外掛自身能力。"

msgid "冲突策略"
msgstr "沖突策略"

msgid "支持跳过、自动生成新 URL、仅更新同一数据包历史页面 3 种策略。"
msgstr "支援跳過、自動生成新 URL、僅更新同一資料包歷史頁面 3 種策略。"

msgid "占位链接"
msgstr "占位連結"

msgid "支持 qiling://page/页面标识 和 qiling://system/login 这类引用；可解析的占位链接会自动转成真实链接，未解析项会保留原样并提示。"
msgstr "支援 qiling://page/頁面標識 和 qiling://system/login 這類引用；可解析的占位連結會自動轉成真實連結，未解析項會保留原樣並提示。"

