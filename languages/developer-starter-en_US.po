msgstr "An import or rollback task is already running. Please try again later."

msgid "回滚完成：已恢复 %1$d 个更新页面，已删除 %2$d 个新建页面。"
msgstr "Rollback complete: restored %1$d updated pages and deleted %2$d new pages."

