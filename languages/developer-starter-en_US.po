msgstr "You selected Apply Site Settings. Please also confirm replacing the current front page before importing."

msgid "当前已有导入/预览任务正在执行，请稍后再试。"
msgstr "An import or preview task is already running. Please try again later."

msgid "已生成临时预览；本次预览页面选择已绑定到后续导入。"
msgstr "Temporary preview generated. The selected preview pages are bound to the following import."

msgid "当前已有导入任务正在执行，请稍后再试。"
msgstr "An import task is already running. Please try again later."

msgid "导入已完成，已自动清空预检缓存。若需再次导入，请重新上传或粘贴 JSON 后再预检。"
msgstr "Import completed and the precheck cache was cleared automatically. To import again, upload or paste JSON and run precheck again."

msgid "JSON 文件上传失败，请重新选择文件。"
msgstr "JSON file upload failed. Please select the file again."

msgid "请上传 .json 格式的数据包文件。"
msgstr "Please upload a package file in .json format."

msgid "上传文件超过安全上限（最大 %s），请拆分数据包后再导入。"
msgstr "The uploaded file exceeds the safety limit (maximum %s). Please split the package before importing."

msgid "上传文件不存在，请重试。"
msgstr "The uploaded file does not exist. Please try again."

msgid "上传文件未通过 JSON 类型校验，请重新选择有效的数据包文件。"
msgstr "The uploaded file failed JSON type validation. Please select a valid package file."

msgid "上传的 JSON 文件内容为空。"
msgstr "The uploaded JSON file is empty."

msgid "请先上传 JSON 文件，或把数据包内容粘贴到文本框中。"
msgstr "Please upload a JSON file first, or paste the package content into the text box."

msgid "执行导入前请先点击“生成临时预览”，并保持同一批勾选页面。"
msgstr "Before importing, click Generate Temporary Preview and keep the same selected pages."

msgid "预览绑定已过期，请重新生成临时预览后再导入。"
msgstr "The preview binding has expired. Please generate a temporary preview again before importing."

msgid "导入内容或勾选页面与预览不一致，请重新生成临时预览后再导入。"
