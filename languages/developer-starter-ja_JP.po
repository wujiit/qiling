msgstr "現在のデータ パッケージのサイズは約 %s です。信頼できるソースからのみインポートし、テスト環境での事前チェックを優先することをお勧めします。"

msgid "当前数据包共包含 %d 个模块，建议分批导入并在导入后复查前台渲染与缓存状态。"
msgstr "現在のデータ パッケージには、合計 %d モジュールが含まれています。これらをバッチでインポートし、インポート後にフロントエンドのレンダリングとキャッシュのステータスを確認することをお勧めします。"

msgid "请先选择至少一个页面再导出数据包。"
msgstr "データ パッケージをエクスポートする前に、少なくとも 1 ページを選択してください。"

msgid "所选页面没有可导出的模块数据。"
msgstr "選択したページにはエクスポートするモジュール データがありません。"

msgid "数据包导出失败，JSON 编码未成功。"
msgstr "パッケージのエクスポートに失敗しました。JSON エンコードが成功しませんでした。"

msgid "页面 ID %d 不存在或不是有效页面。"
msgstr "ページ ID %d が存在しないか、有効なページではありません。"

msgid "页面“%s”属于系统保留页，不参与多页包导出。"
msgstr "ページ「%s」はシステムで予約されているページであり、複数ページのパッケージのエクスポートには参加しません。"

msgid "页面“%s”使用了系统模板，不参与多页包导出。"
msgstr "ページ「%s」はシステム テンプレートを使用しており、複数ページのパッケージのエクスポートには参加しません。"

msgid "页面“%s”不是启灵主题的模块装修模板，不参与多页包导出。"
msgstr "ページ \"%s\" は QILING テーマ モジュール デコレーション テンプレートではないため、複数ページ パッケージのエクスポートには参加しません。"

msgid "页面“%s”不是纯模块装修页，或没有可导出的模块数据。"
msgstr "ページ「%s」は純粋なモジュール装飾ページではないか、エクスポート可能なモジュール データがありません。"

msgid "菜单项“%s”不在当前导出页面范围内，已从整站包导航中跳过。"
msgstr "メニュー項目「%s」は、現在のエクスポート ページの範囲内にないため、サイト パッケージ ナビゲーション全体からスキップされています。"

msgid "本地整站包只记录资源清单，不复制媒体库文件；图片字段保留原 URL 或相对路径。"
msgstr "ローカルのサイト全体パッケージはリソース リストのみを記録し、メディア ライブラリ ファイルはコピーしません。画像フィールドには、元の URL または相対パスが保持されます。"

msgid "没有可导入的页面数据。"
msgstr "インポートするページ データがありません。"

msgid "URL 已存在，但不是当前数据包的历史页面，已按安全策略跳过。"
msgstr "URL はすでに存在しますが、現在のパケットの履歴ページではないため、セキュリティ ポリシーによってスキップされました。"

msgid "URL 已存在，已按当前策略跳过。"
msgstr "URL はすでに存在しますが、現在のポリシーによってスキップされています。"

msgid "导入页面"
msgstr "インポートページ"

msgid "找不到需要更新的历史页面。"
msgstr "更新する必要のある履歴ページが見つかりません。"

msgid "历史页面不存在，无法执行更新。"
msgstr "履歴ページが存在しないため、更新できません。"

msgid "页面更新成功。"
msgstr "ページ更新に成功しました。"

msgid "页面副本创建成功。"
msgstr "ページのコピーが正常に作成されました。"

msgid "页面创建成功。"
msgstr "ページの作成に成功しました。"

msgid "已按安全策略跳过站点设置应用（未勾选“应用站点设置”）。"
msgstr "セキュリティ ポリシーにより、サイト設定の適用がスキップされました ([サイト設定を適用する] がチェックされていません)。"

msgid "回滚失败：缺少导入记录 ID。"
msgstr "ロールバックに失敗しました: インポート レコード ID がありません。"

msgid "回滚失败：找不到对应的导入记录。"
msgstr "ロールバックに失敗しました: 対応するインポート レコードが見つかりません。"

msgid "该导入记录已经执行过回滚。"
msgstr "このインポート レコードはすでにロールバックされています。"

msgid "回滚失败：该记录没有可用快照。"
msgstr "ロールバック失敗:コンテンツ。"

msgid "页面 #%d 删除失败，请手动检查。"
msgstr "ページ #%d を削除できませんでした。手動で確認してください。"

msgid "页面快照无效，缺少页面 ID。"
msgstr "ページのスナップショットが無効です。ページ ID がありません。"

msgid "回滚失败：页面 #%d 已不存在。"
msgstr "ロールバックに失敗しました: ページ #%d はもう存在しません。"

msgid "站点设置里的首页引用 %s 在当前数据包中不存在，导入时将忽略首页设置。"
msgstr "サイト設定のホームページ参照 %s は現在のデータ パッケージに存在しないため、インポート時にホームページ設定は無視されます。"

msgid "站点设置里的文章列表页引用 %s 在当前数据包中不存在，导入时将忽略文章列表页设置。"
msgstr "サイト設定の記事リスト ページ参照 %s は現在のデータ パッケージに存在しないため、インポート時に記事リスト ページの設定は無視されます。"

msgid "跳过已存在页面"
msgstr "既存のページをスキップする"

msgid "如果 URL 已存在，就跳过该页，不覆盖原页面。"
msgstr "URL がすでに存在する場合、そのページはスキップされ、元のページは上書きされません。"

msgid "自动生成新 URL"
msgstr "新しい URL を自動生成する"

msgid "如果 URL 已存在，就自动改成新 URL 创建副本。"
msgstr "URL がすでに存在する場合は、自動的に新しい URL に変更され、コピーが作成されます。"

msgid "仅更新同一数据包历史页面"
msgstr "同じパケット履歴ページのみを更新する"

msgid "只有匹配同一数据包 ID 和页面标识的旧页面才会更新，其余一律跳过。"
msgstr "同じパケット ID とページ識別子に一致する古いページのみが更新され、残りはスキップされます。"

msgid "用于单页或多页面装修复用，只导出页面模块、页面设置和页面互链。"
msgstr "単一ページまたは複数ページの装飾に使用され、ページ モジュール、ページ設定、ページ インターリンクのみがエクスポートされます。"

msgid "用于本地整站迁移，可额外携带设计系统、内容模型、菜单和站点身份设置。"
msgstr "ローカルのフルサイト移行に使用され、デザイン システム、コンテンツ モデル、メニュー、サイト ID 設定を追加で引き継ぐことができます。"

msgid "页面“%s”没有可导入的模块数据。"
msgstr "ページ「%s」にはインポートするモジュール データがありません。"

msgid "页面“%1$s”包含的模块数量超过安全上限（最多 %2$d 个），当前数据包不会导入。"
msgstr "ページ「%1$s」には安全制限 (最大 %2$d) を超えるモジュールが含まれており、現在のデータ パッケージはインポートされません。"

msgid "页面“%1$s”的第 %2$d 个模块结构无效。"
msgstr "ページ「%1$s」コンテンツ %2$d モジュール構造が無効です。"

msgid "页面“%1$s”包含未注册模块：%2$s。"
msgstr "ページ「%1$s」には、登録されていないモジュール:%2$s が含まれています。"

msgid "模块 %1$s：%2$s"
msgstr "モジュール %1$s:%2$s"

msgid "字段 %s 未在当前模块注册，已自动忽略。"
msgstr "フィールド %s は現在のモジュールに登録されていないため、自動的に無視されます。"

msgid "字段 %1$s 的列表项数量超过安全上限，导入时仅保留前 %2$d 项。"
msgstr "フィールド %1$s のリスト項目の数が安全な制限を超えているため、インポート中に最初の %2$d 項目のみが保持されます。"

msgid "字段 %s 的子项格式无效，已跳过。"
msgstr "フィールド %s のサブキー形式が無効であるため、スキップされました。"

msgid "字段 %s 的间距值已被自动规范化，导入后间距表现可能与原包略有差异。"
msgstr "フィールド %s の間隔値は自動的に正規化されており、インポート後の間隔のパフォーマンスは元のパッケージと若干異なる場合があります。"

msgid "字段 %s 的选项值不受当前主题支持，已回退到模块默认值。"
msgstr "フィールド %s のオプション値は現在のテーマではサポートされていないため、モジュールのデフォルト値に戻りました。"

msgid "字段 %s 的选项值不受当前主题支持，已回退到第一个可用选项。"
msgstr "フィールド %s のオプション値は現在のテーマではサポートされていないため、最初に使用可能なオプションに戻りました。"

msgid "字段 %s 使用了不在白名单内的链接协议（仅支持 http/https/mailto/tel 与 qiling://page/*、qiling://system/*），导入时已自动清理。"
msgstr "フィールド %s は、ホワイトリストにないリンク プロトコル (http/https/mailto/tel および qiling://page/*、qiling://system/* のみがサポートされています) を使用しており、インポート中に自動的に削除されています。"

msgid "字段 %s 的链接已被清理，导入后相关按钮或跳转可能不可用。"
msgstr "フィールド %s のリンクがクリーンアップされたため、インポート後に関連するボタンまたはジャンプが使用できなくなる可能性があります。"

msgid "字段 %s 使用了不安全或无效的媒体地址，导入时已自动清理。"
msgstr "フィールド %s は安全でないまたは無効なメディア アドレスを使用しており、インポート中に自動的に削除されました。"

msgid "字段 %s 的媒体地址无效，导入后相关图片或文件位可能不显示。"
msgstr "フィールド %s のメディア アドレスが無効であるため、インポート後に関連する画像またはファイル ビットが表示されない可能性があります。"

msgid "字段 %s 的 SVG 图标未通过安全过滤，导入后图标可能缺失。"
msgstr "フィールド %s の SVG アイコンはセキュリティ フィルタリングを通過せず、インポート後にアイコンが失われる可能性があります。"

msgid "字段 %s 的文案较长，导入后可能出现换行、挤压卡片或按钮尺寸变化。"
msgstr "フィールド %s のコピーは長いため、インポート後に改行、カードの押し出し、またはボタン サイズの変更が発生する可能性があります。"

msgid "字段 %s 包含高风险 HTML 标签，导入时会按主题安全规则自动过滤。"
msgstr "フィールド %s には高リスクの HTML タグが含まれており、インポート時にテーマのセキュリティ ルールによって自動的にフィルタされます。"

msgid "字段 %s 包含事件属性写法，导入时会按主题安全规则自动过滤。"
msgstr "フィールド %s にはイベント属性の書き込みメソッドが含まれており、インポート時にトピック セキュリティ ルールに従って自動的にフィルターされます。"

msgid "字段 %s 的内容体积较大，建议导入后关注页面性能与缓存命中情况。"
msgstr "フィールド %s の内容は大きくなります。インポート後のページのパフォーマンスとキャッシュ ヒットに注意することをお勧めします。"

msgid "已应用站点标题。"
msgstr "サイトタイトルが適用されました。"

msgid "已应用站点副标题。"
msgstr "サイトのサブタイトルが適用されました。"

msgid "已应用全局设计系统设置。"
msgstr "グローバル デザイン システム設定が適用されました。"

msgid "已应用内容模型中心设置。"
msgstr "コンテンツ モデル センターの設定が適用されました。"

msgid "首页设置未生效：数据包中未找到对应页面。"
msgstr "ホームページ設定は有効になりません。対応するページがデータ パッケージ内に見つかりません。"

msgid "首页设置未生效：目标页面不存在。"
msgstr "ホームページ設定は有効になりません。ターゲット ページが存在しません。"

msgid "首页设置未生效：目标页面不是已发布状态。"
msgstr "ホーム ページの設定は有効になりません。ターゲット ページは公開状態ではありません。"

msgid "已将“%s”设置为首页。"
msgstr "「%s」がホームページとして設定されました。"

msgid "文章列表页设置未生效：数据包中未找到对应页面。"
msgstr "記事リスト ページの設定は有効になりませんでした。対応するページがデータ パッケージ内に見つかりませんでした。"

msgid "文章列表页设置未生效：目标页面不存在。"
msgstr "記事一覧ページの設定は有効になりません。対象のページが存在しません。"

msgid "已将“%s”设置为文章列表页。"
msgstr "「%s」を記事一覧ページに設定しました。"

msgid "已应用主题设置。"
msgstr "テーマ設定が適用されました。"

msgid "导入菜单"
msgstr "インポートメニュー"

msgid "菜单“%s”创建失败，已跳过。"
msgstr "メニュー「%s」の作成に失敗しました。コンテンツです。"

msgid "已创建菜单“%1$s”，包含 %2$d 个菜单项。"
msgstr "%2$d メニュー項目を含むメニュー「%1$s」が作成されました。"

msgid "默认模板"
msgstr "デフォルトのテンプレート"

msgid "页面“%1$s”引用了不存在的页面标识：%2$s。导入后该占位链接会保留原样。"
msgstr "ページ「%1$s」は、存在しないページ識別子 %2$s を参照しています。プレースホルダー リンクはインポート後もそのまま残ります。"

msgid "页面“%1$s”引用了未就绪的系统入口：%2$s。导入后该占位链接会保留原样。"
msgstr "ページ「%1$s」は、準備ができていないシステム エントリ %2$s を参照しています。プレースホルダー リンクはインポート後もそのまま残ります。"

msgid "页面 %s 的包内链接已自动解析。"
msgstr "ページ %s のパッケージ内リンクは自動的に解決されました。"

msgid "没有可预览的页面数据。"
msgstr "プレビューするページ データがありません。"

msgid "[预览] %s"
msgstr "[preview] %s"

msgid "临时预览已生成。"
msgstr "一時的なプレビューが生成されました。"

msgid "页面有图片，但没有发现 fetchpriority=\"high\" 或图片 preload；首屏大图建议指定 LCP 优先级。"
msgstr "ページ上に画像がありますが、fetchpriority=\"high\" または画像のプリロードが見つかりません。最初の画面では大きな画像に対して LCP 優先度を指定することをお勧めします。"

msgid "页面存在多个 fetchpriority=\"high\" 图片，建议只保留最可能成为 LCP 的首屏图片。"
msgstr "ページ上に複数の fetchpriority=\"high\" 画像があります。 LCP になる可能性が最も高い最初の画面イメージのみを保持することをお勧めします。"

msgid "图片缺少 alt 属性；内容图需要描述文字，装饰图也应显式 alt=\"\"。"
msgstr "画像には alt 属性がありません。コンテンツ画像には説明テキストが必要で、装飾画像にも明示的な alt=\"\" が必要です。"

msgid "图片缺少 width/height 或 aspect-ratio，可能造成布局位移。"
msgstr "画像の幅/高さまたはアスペクト比が不足しているため、レイアウトがずれる可能性があります。"

msgid "图片缺少 loading 属性；非首屏图片建议 lazy，首屏关键图建议 eager。"
msgstr "画像には読み込み属性がありません。最初の画面にない画像には Lazy が推奨され、最初の画面のキー画像には Eager が推奨されます。"

msgid "图片缺少 decoding=\"async\"，可能阻塞渲染。"
msgstr "画像に decoding=\"async\" が欠落しているため、レンダリングがブロックされる可能性があります。"

msgid "页面包含 JPG/PNG 图片，但没有发现 WebP/AVIF 资源或 source，建议为大图提供现代格式。"
msgstr "このページには JPG/PNG 画像が含まれていますが、WebP/AVIF リソースまたはソースが見つかりませんでした。大きな画像には最新の形式を提供することをお勧めします。"

msgid "发现空标题标签，可能影响屏幕阅读器和 SEO 结构。"
msgstr "空のタイトル タグが見つかり、スクリーン リーダーと SEO 構造に影響を与える可能性があります。"

msgid "页面没有标题标签，建议至少有一个清晰的 H1。"
msgstr "ページにはタイトル タグがありません。少なくとも明確な H1 を含めることをお勧めします。"

msgid "页面缺少 H1，建议每个主要页面保留一个主标题。"
msgstr "このページには H1 が欠落しているため、各メイン ページにメイン見出しを保持することをお勧めします。"

msgid "页面存在多个 H1，建议保留一个主 H1，其余改为 H2/H3。"
msgstr "ページ上に複数の H1 があります。メインの H1 を 1 つ保持し、残りを H2/H3 に変更することをお勧めします。"

msgid "标题层级出现跳级，建议按 H1 > H2 > H3 顺序组织内容。"
msgstr "タイトルレベルはスキップされます。 H1 > H2 > H3 の順序でコンテンツを構成することを推奨します。"

msgid "表单控件缺少可访问名称，请添加 label、aria-label 或 aria-labelledby。"
msgstr "フォーム コントロールにアクセス可能な名前がありません。label、aria-label、または aria-labelledby を追加してください。"

msgid "按钮缺少可访问名称，请补充按钮文字或 aria-label。"
msgstr "ボタンにはアクセス可能な名前がありません。ボタンのテキストまたは aria-label を入力してください。"

msgid "正文 / 页面背景"
msgstr "テキスト/ページの背景"

msgid "标题 / 页面背景"
msgstr "タイトル/ページの背景"

msgid "弱化文字 / 页面背景"
msgstr "テキスト/ページの背景を弱める"

msgid "品牌主色 / 页面背景"
msgstr "メインブランドカラー/ページ背景"

msgid "暗色正文 / 暗色背景"
msgstr "暗いテキスト/暗い背景"

msgid "%1$s 对比度为 %2$s，低于 WCAG AA 正文建议值 4.5。"
msgstr "%1$s コントラスト比は %2$s で、WCAG AA テキスト推奨の 4.5 を下回ります。"

msgid "内联样式文字与背景色对比度偏低，移动端和弱视用户可能难以阅读。"
msgstr "インライン スタイルのテキストと背景色のコントラストが低いため、モバイル ユーザーや視力の低いユーザーにとっては読みにくい場合があります。"

msgid "发现较长的连续字符，移动端可能横向溢出；建议允许断行或改短展示文案。"
msgstr "長い連続文字が見つかった場合、モバイル端末が横にはみ出す可能性があります。改行を許可するか、表示コピーを短くすることをお勧めします。"

msgid "发现 white-space: nowrap，窄屏下可能造成文字溢出。"
msgstr "狭い画面では空白:nowrap によりテキストがオーバーフローする可能性があることがわかりました。"

msgid "发现较大的固定像素宽度，移动端可能出现横向滚动。"
msgstr "より大きな固定ピクセル幅が見つかり、モバイルでは水平スクロールが発生する可能性があります。"

msgid "存在未声明尺寸的图片，浏览器无法提前预留空间，可能造成 CLS。"
